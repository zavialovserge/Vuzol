<UserControl x:Class="Vuzol.View.AddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Vuzol.View"
             xmlns:convertor="clr-namespace:Vuzol.Converteres"
             mc:Ignorable="d" 
             d:DesignHeight="600"  Background="White" >
    <UserControl.Resources>
        <convertor:StringToIntConvertor x:Key="myConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid DataContext="{Binding PropertyAdd}" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="30" />
                <RowDefinition Height="60"/>
                <RowDefinition Height="30" />
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0"  Grid.Column="0" Content="Інвентарний номер" HorizontalAlignment="Center" />
            <TextBox  Grid.Row="1" Grid.Column="0" Name="InventoryNubmer"  
        Text="{Binding InventoryNumberStr,
        UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="0" Grid.Column="1" Content="Найменування"  HorizontalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1"  Text="{Binding Name}"/>
            <Label Grid.Row="0" Grid.Column="2" Content="Заводський номер" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="2" 
             Text="{Binding FactoryNumberStr,
             UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="0" Grid.Column="3" Content="Формуляр" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="3"  Text="{Binding FormId,
                                                                UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="0" Grid.Column="4" Content="Накладна" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="4"  Text="{Binding InvoiceId,
                                                                   UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="2"  Grid.Column="0" Content="Книга закріплень" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="0"  Text="{Binding BookId,
                                                               UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="2" Grid.Column="1" Content="Сторінка в книзі закріплень" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BookPage,
                                                                 UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="2" Grid.Column="2" Content="Книга обліку"  HorizontalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="2"  Text="{Binding OrderBookId,
                                                                 UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="2" Grid.Column="3" Content="Сторінка в книзі обліку" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="3"  Text="{Binding OrderBookPage,
                                                                 UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="2" Grid.Column="4" Content="Мітка" HorizontalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding PropertyTypeNameList}" 
                      SelectedValue="{Binding PropertyTypeName,UpdateSourceTrigger=PropertyChanged}"  
                      Grid.Row="3" Grid.Column="4" />
            <Label Grid.Row="4" Grid.Column="0" Content="Наказ на експлуатацію" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding OrderId,
                                                                 UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="4" Grid.Column="1" Content="Дата наказу в експлуатацію" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1"  Text="{Binding OrderDate,
                                                                 UpdateSourceTrigger=PropertyChanged}"  />
            <Label Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Content="Відповідальний" HorizontalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding EmployeeList}" 
          SelectedValue="{Binding FIO_R_STR,UpdateSourceTrigger=PropertyChanged}"  
          Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2"/>
            <Label Grid.Row="4" Grid.Column="4" Content="Статус" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="4" />
            <ComboBox ItemsSource="{Binding PropertyStatusNameList}" 
            SelectedValue="{Binding PropertyStatusName,UpdateSourceTrigger=PropertyChanged}"  
            Grid.Row="5" Grid.Column="4" />
            <Label Grid.Row="6" Grid.ColumnSpan="5" Content="Додаткова інформація" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="7" Grid.ColumnSpan="5" 
             Text="{Binding Additionalnfo}"/>
            <Label Grid.Row="8" Grid.ColumnSpan="5" Content="Комплектність(залізо)" HorizontalAlignment="Center"/>
            <Grid Grid.Row="9" Grid.ColumnSpan="5" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0">
                    
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Додати"  Command="{Binding AddComlectnessCommand}" Width="400" />
                    <Button Content="Видалити"  Command="{Binding DelComlectnessCommand}" 
                            CommandParameter="{Binding SelectedItem, ElementName=myDataGrid}" Width="400"/>
                </StackPanel>
            </Grid>
            <!--<TextBox Grid.Row="9" Grid.ColumnSpan="5" 
             Text="{Binding CompletnessId,
                   UpdateSourceTrigger=PropertyChanged}"/>-->
            <Label Grid.Row="10" Grid.ColumnSpan="5" Content="Комплектність(програмне забазпечення)" HorizontalAlignment="Center"/>
            <Grid Grid.Row="11" Grid.ColumnSpan="5" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0">

                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Додати"  Command="{Binding AddComlectnessCommand}" Width="400" />
                    <Button Content="Видалити"  Command="{Binding DelComlectnessCommand}" 
                CommandParameter="{Binding SelectedItem, ElementName=myDataGrid}" Width="400"/>
                </StackPanel>
            </Grid>
            <!--<TextBox Grid.Row="11" Grid.ColumnSpan="5" 
 Text="{Binding CompletnessId,
       UpdateSourceTrigger=PropertyChanged}"/>-->
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="{Binding ButtonName}"   Command="{Binding AddPropertyCommand}"  Width="200"/>
            <Button Content="Повернутись назад" Command="{Binding HomeCommand}" Name="EditBtn"  Width="200"/>
        </StackPanel>
        
    </Grid>
</UserControl>
