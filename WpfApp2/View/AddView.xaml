<UserControl x:Class="Vuzol.View.AddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Vuzol.View"
             xmlns:convertor="clr-namespace:Vuzol.Converteres"
             mc:Ignorable="d" 
             d:DesignHeight="1000" Background="#FAFAFA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Osnovni parametri -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Основні параметри"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Інвентарний номер"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.InventoryNumberStr, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Найменування"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.Name}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Заводський номер"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.FactoryNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dokumenty -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Документи"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Формуляр"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.FormId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Накладна"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.InvoiceId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Мітка"/>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding PropertyAdd.PropertyTypeNameList}" 
                                          SelectedValue="{Binding PropertyAdd.PropertyTypeName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Knugy obliku -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Книга обліку"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Книга закріплень"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.BookId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Сторінка"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.BookPage, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Книга обліку"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.OrderBookId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Сторінка"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.OrderBookPage, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Finansovie dani -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Фінансовиі характеристики"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Наказ на експлуатацію"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.OrderId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Дата наказу"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.OrderDate, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Кількість"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Ціна"/>
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PropertyAdd.Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Vidpovidalnist -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Відповідальність і статус"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Відповідальний"/>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding PropertyAdd.EmployeeList}" 
                                          SelectedValue="{Binding PropertyAdd.FIO_R_STR, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Статус"/>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding PropertyAdd.PropertyStatusNameList}" 
                                          SelectedValue="{Binding PropertyAdd.PropertyStatusName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Додаткова інформація" Margin="0,15,0,5"/>
                        <TextBox Style="{StaticResource InputTextBoxStyle}" Height="80" TextWrapping="Wrap" 
                                 Text="{Binding PropertyAdd.Additionalnfo}"/>
                    </StackPanel>
                </Border>

                <!-- Komplektnist zalizo -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Комплектность - залізо"/>
                        <DataGrid Style="{StaticResource ModernDataGridStyle}" Height="200"
                                  ItemsSource="{Binding PropertyAdd.HardwareEquipmentList}" 
                                  SelectedItem="{Binding PropertyAdd.SelectedHardwareEquipment}" 
                                  IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер" Binding="{Binding CountId}" Width="80"/>
                                <DataGridTextColumn Header="Найменування" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Style="{StaticResource AddButtonStyle}" Content="Додати" Command="{Binding PropertyAdd.AddHardwareEquipmentCommand}" Width="100"/>
                            <Button Style="{StaticResource EditButtonStyle}" Content="Змінити" Command="{Binding PropertyAdd.EditHardwareEquipmentCommand}" Width="100"/>
                            <Button Style="{StaticResource DeleteButtonStyle}" Content="Видалити" Command="{Binding PropertyAdd.DelHardwareEquipmentCommand}" Width="100"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Komplektnist prohramne zabezpechennya -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Комплектність - програмне забезпечення"/>
                        <DataGrid Style="{StaticResource ModernDataGridStyle}" Height="200"
                                  ItemsSource="{Binding PropertyAdd.SoftwareEquipmentList}" 
                                  SelectedItem="{Binding PropertyAdd.SelectedSoftwareEquipment}" 
                                  IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер" Binding="{Binding CountId}" Width="80"/>
                                <DataGridTextColumn Header="Найменування" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Style="{StaticResource AddButtonStyle}" Content="Додати" Command="{Binding PropertyAdd.AddSoftwareEquipmentCommand}" Width="100"/>
                            <Button Style="{StaticResource EditButtonStyle}" Content="Змінити" Command="{Binding PropertyAdd.EditSoftwareEquipmentCommand}" Width="100"/>
                            <Button Style="{StaticResource DeleteButtonStyle}" Content="Видалити" Command="{Binding PropertyAdd.DelSoftwareEquipmentCommand}" Width="100"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Knopky diyi -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" >
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding ButtonName}" Command="{Binding AddPropertyCommand}" Width="150"/>
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Повернутись назад" Command="{Binding HomeCommand}" Width="150"/>
        </StackPanel>
    </Grid>
</UserControl>
