<UserControl x:Class="Vuzol.View.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Vuzol.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <DataGrid HorizontalAlignment="Left" 
                  Grid.Row="0" Name="employeeDataGrid" ItemsSource="{Binding EmployeesList}" 
                  SelectedItem="{Binding SelectedEmployee}" SelectedValue="{Binding SelectedEmployee}" 
                    IsReadOnly="True" AutoGenerateColumns="False" >
            <DataGrid.Columns >
                <DataGridTextColumn Width="80"   Header="Номер" Binding="{Binding Id}" >
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment"
                            Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="120" Header="Ім'я" Binding="{Binding FirstName}"/>
                <DataGridTextColumn Width="120" Header="Прізвище" Binding="{Binding LastName}"/>
                <DataGridTextColumn Width="120" Header="По батькові" Binding="{Binding FatherName}"/>
                <DataGridTextColumn Width="120" Header="Посада" Binding="{Binding Position}"/>
                <DataGridTextColumn Width="120" Header="Звання" Binding="{Binding RankDescription}"/>
                <DataGridTextColumn Width="120" Header="Підрозділ" Binding="{Binding UnitName}"/>                
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Додати" Name="AddBtn" Command="{Binding AddEmployeeCommand}"  Width="200"/>
            <Button Content="Коригувати" Name="EditBtn" Command="{Binding EditEmployeeyCommand}"  Width="200"/>
            <Button Content="Видалити" Name="DelBtn" Command="{Binding DelEmployeeCommand}"  Width="200"/>
            <Button Content="Повернутись назад" Name="HomeBtn" Command="{Binding HomeCommand}"  Width="200"/>            
        </StackPanel>
    </Grid>
</UserControl>
